# Normaliza todos los archivos de texto a LF en el repositorio
* text=auto eol=lf

# Archivos de código fuente — siempre LF
*.js   text eol=lf
*.mjs  text eol=lf
*.ts   text eol=lf
*.vue  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binarios — sin conversión
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
